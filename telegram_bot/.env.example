# Telegram bot token (from @BotFather) — required
TELEGRAM_BOT_TOKEN=

# Base directory for per-user work dirs (default: ~/.carcara_telegram)
# CARCARA_TG_BASE_DIR=

# Path to an alternative Carcará config.toml (default: ~/.kimi/config.toml)
# CARCARA_CONFIG_FILE=

# Model override (default: from config.toml)
# CARCARA_MODEL=

# Show thinking output in chat (default: false)
# CARCARA_SHOW_THINKING=

# Default approval mode: "inline" or "yolo" (default: inline)
# CARCARA_DEFAULT_APPROVAL=

# Comma-separated Telegram user IDs allowed to run privileged commands
# CARCARA_ADMIN_IDS=

# Seconds to wait for an approval before auto-rejecting (default: 30, max: 30)
# CARCARA_APPROVAL_TIMEOUT=

# Stream refresh interval in seconds (default: 0.6)
# CARCARA_STREAM_REFRESH=

# Max chars per streaming message (default: 3500)
# CARCARA_STREAM_MAX_CHARS=

# VOSK model path override
# CARCARA_VOSK_MODEL=
